#!/usr/bin/env bash
# `harness <module> <command> ...` — every module operation from one shell command (see harness --help).
# A background helper (tools/harness_cmd.py --serve) keeps the ROS clients alive, so a command answers at once.
# `harness nodes ...` manages the node processes themselves (no ROS, no daemon): the one thing that must
# work when nothing else runs.
cd "$(dirname "$(readlink -f "$0")")/.."
SOCK=/tmp/harness_cmd.sock

# ---------------------------------------------------------------- node processes
# name | pgrep pattern | start command   (one node per line; restart/log names use the first field)
NODES="piper|harness_arm/piper_nod[e]|ros2 launch harness_arm piper.launch.py
camera|harness_vision/tag_nod[e]|ros2 launch harness_vision camera.launch.py
dtv|harness_dtv/dtv_nod[e]|ros2 run harness_dtv dtv_node
bunny|harness_instrument/bunny_nod[e]|ros2 run harness_instrument bunny_node
pipette|harness_pipette/pipette_nod[e]|ros2 run harness_pipette pipette_node
workflows|tools/workflow_serve[r].py|python3 tools/workflow_server.py
gateway|tools/gateway_serve[r].py|python3 tools/gateway_server.py"
# The arm node owns can0 and dies at start if the interface is down (every PC reboot leaves it down until the
# boot-time CAN config exists). can_up brings it up at 1 Mbps; `ip link set` needs root, so sudo asks for the
# password in the terminal when it is not cached (no terminal = it fails and the arm node is not started).
CAN_IF=${CAN_IF:-can0}
can_up() {
  local st; st=$(ip -details link show "$CAN_IF" 2>/dev/null) || { echo "$CAN_IF: no such interface (CAN adapter unplugged? lsusb | grep 1d50:606f)"; return 1; }
  grep -q " state UP " <<<"$st" && grep -q "bitrate 1000000" <<<"$st" && { echo "$CAN_IF: up @1 Mbps"; return 0; }
  echo "$CAN_IF: down -- bringing it up at 1 Mbps (needs sudo)"
  sudo ip link set "$CAN_IF" down 2>/dev/null
  sudo ip link set "$CAN_IF" type can bitrate 1000000 && sudo ip link set "$CAN_IF" up || { echo "$CAN_IF: could not bring it up (sudo refused or no terminal for the password)"; return 1; }
  ip -details link show "$CAN_IF" | grep -q " state UP " && { echo "$CAN_IF: up @1 Mbps"; return 0; }
  echo "$CAN_IF: still down after ip link set up"; return 1
}
start_bg() {
  pgrep -f "$2" >/dev/null && { echo "$1: already running"; return; }
  [ "$1" = piper ] && ! can_up && { echo "piper: NOT started ($CAN_IF down)"; return; }
  setsid nohup $3 >/tmp/$1.log 2>&1 </dev/null &
  for i in $(seq 1 60); do pgrep -f "$2" >/dev/null && { echo "$1: started"; return; }; sleep 0.25; done   # ros2 launch needs a few s before the node process exists: a second start in that window would double it
  echo "$1: launched, node process not seen within 15 s (see /tmp/$1.log)"
}
kill_node() { pkill -f "$2" && echo "$1: stopped" || echo "$1: was not running"; }
each_node() { while IFS='|' read -r n p c; do "$1" "$n" "$p" "$c"; done <<<"$NODES"; }
# The Bunny app (GUI, or `main.py harness` headless) serves port 7801 itself; it is started on the Bunny, not from here.
bunny_check() { timeout 3 bash -c "</dev/tcp/${BUNNY_HOST:-192.168.7.2}/7801" 2>/dev/null && echo "bunny server: reachable" || echo "bunny server: NOT reachable (start the Bunny app)"; }
nodes() {
  source rosenv.sh 2>/dev/null
  case "$1" in
    start)   each_node start_bg; bunny_check ;;
    stop)    for n in dtv bunny pipette workflows gateway; do kill_node "$n" "$(grep "^$n|" <<<"$NODES" | cut -d'|' -f2)"; done
             pkill -f "harness_cmd.py --serv[e]" && echo "CLI daemon: stopped"
             echo "(arm, camera nodes and the Bunny app left running)" ;;
    restart) line=$(grep "^$2|" <<<"$NODES") || { echo "usage: harness nodes restart piper|camera|dtv|bunny|pipette|workflows|gateway"; exit 2; }
             IFS='|' read -r n p c <<<"$line"; kill_node "$n" "$p"; sleep 2; start_bg "$n" "$p" "$c" ;;
    status)  timeout 10 ros2 node list 2>/dev/null; bunny_check ;;
    *)       echo "usage: harness nodes start|stop|status|restart piper|camera|dtv|bunny|pipette|workflows|gateway"; exit 2 ;;
  esac
}

# ---------------------------------------------------------------- commands
case "$1" in
  nodes) nodes "${@:2}"; exit $? ;;
  gateway) [ "$2" = key ] || { echo "usage: harness gateway key"; exit 2; }
           exec python3 tools/gateway_server.py --key ;;   # the shared key for the twin (created if missing)
  daemon-stop) pkill -f "harness_cmd.py --serve"; rm -f $SOCK; echo stopped; exit 0 ;;
  arm)
    case "$2" in
      teach|locate) source rosenv.sh; exec ros2 run harness_calibration "$2" "${@:3}" ;;
    esac ;;
esac
if [ ! -S $SOCK ] || ! pgrep -f "harness_cmd.py --serve" >/dev/null; then
  ( source rosenv.sh; setsid nohup python3 tools/harness_cmd.py --serve >/tmp/harness_cmd.log 2>&1 </dev/null & )   # own session: terminal Ctrl-C never reaches it
  for i in $(seq 1 50); do [ -S $SOCK ] && break; sleep 0.1; done
  sleep 3     # first start only: let ROS discovery deliver the 2 Hz status topics
fi
exec python3 tools/harness_cmd.py "$@"
