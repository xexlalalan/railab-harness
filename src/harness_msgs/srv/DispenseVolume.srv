float64 volume_ml         # liquid volume to dispense
float64 density_g_per_ml  # 0 = the Bunny's configured density (water 1.0); the Bunny doses the equivalent mass by weight
---
bool success
string outcome            # finished | stopped | bottle empty | error text
float64 target_g          # mass target the Bunny derived from the volume
float64 actual_g
string message
