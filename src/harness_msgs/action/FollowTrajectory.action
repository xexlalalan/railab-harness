# Stream a time-stamped joint trajectory (PROJECT_SPEC.md "2026-10-22 — Planner bedrock").
# The arm node re-validates every point (limits, workspace, floor, joint speed, start = current
# joints), then streams the target interpolated at the current time with move_j at traj_rate_hz.
trajectory_msgs/JointTrajectory trajectory   # joint1..joint6; time_from_start strictly increasing;
                                              # first point = the current joints (+- traj_start_tol_rad)
float64 max_tracking_error_rad               # 0 = node default traj_tracking_error_rad
string label                                 # shown in the node log
---
bool success
string message
float64 max_tracking_error_rad               # worst |measured - commanded| joint error seen
float64 seconds                              # time spent streaming
---
float64 progress                             # 0..1 of the trajectory time
float64 tracking_error_rad
uint32 point_index
