<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>harness_modules</name>
  <version>0.1.0</version>
  <description>The module interface's adapter nodes (2026-11-20): one per device, the contract (command service, state topic, the harness heartbeat) above, the device's EXISTING node below as a ROS client. Side by side with the old gateway; nothing here starts by itself.</description>
  <maintainer email="xexlalalan@gmail.com">bunny-harness</maintainer>
  <license>Proprietary</license>
  <depend>rclpy</depend>
  <depend>railab_harness</depend>
  <depend>harness_module_msgs</depend>
  <depend>harness_msgs</depend>
  <depend>harness_arm</depend>
  <depend>harness_planner</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>action_msgs</depend>
  <export><build_type>ament_python</build_type></export>
</package>
